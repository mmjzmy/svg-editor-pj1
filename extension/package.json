{
  "name": "svg-outline-pj1",
  "displayName": "SVG Outline PJ1",
  "description": "SVG explorer badge and native outline for VSCode",
  "version": "0.2.0",
  "publisher": "mmjzmy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:svg"
  ],
  "contributes": {
    "languages": [
      {
        "id": "svg",
        "extensions": [
          ".svg"
        ],
        "aliases": [
          "SVG"
        ]
      }
    ],
    "commands": [
      {
        "command": "svgOutline.refresh",
        "title": "SVG: Refresh Explorer"
      }
    ],
    "configuration": {
      "title": "SVG Outline",
      "properties": {
        "svgOutline.demo": {
          "type": "boolean",
          "default": false,
          "description": "Open SVG files as text and focus the Outline. Used for reproducible screenshots."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
